---
import { siteConfig } from "../config";
import { getLabels, type Lang } from "../i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getLabels(lang);
---

{siteConfig.social?.phone && (
  <a
    id="floating-contact"
    href={`tel:${siteConfig.social.phone}`}
    class="fixed bottom-6 right-6 z-40 flex items-center gap-2 px-4 py-3 rounded-full shadow-lg text-white font-medium opacity-0 pointer-events-none transition-all duration-500 hover:scale-105"
    style={`background-color: ${siteConfig.highlightColor}`}
    aria-label={`${t.contactMe} – ${siteConfig.social.phoneDisplay || siteConfig.social.phone}`}
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
    </svg>
    <span class="hidden sm:inline text-sm">{siteConfig.social.phoneDisplay || siteConfig.social.phone}</span>
  </a>
)}

<script>
  window.addEventListener("scroll", () => {
    const fab = document.getElementById("floating-contact");
    if (!fab) return;
    if (window.scrollY > 500) {
      fab.classList.remove("opacity-0", "pointer-events-none");
      fab.classList.add("opacity-100", "pointer-events-auto");
    } else {
      fab.classList.add("opacity-0", "pointer-events-none");
      fab.classList.remove("opacity-100", "pointer-events-auto");
    }
  });
</script>
